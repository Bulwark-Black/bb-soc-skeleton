{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BB SOC integration pack 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packVersion",
    "name",
    "role",
    "targets",
    "sourceId",
    "appId",
    "installDirectory",
    "privateDirectory",
    "storageDirectory",
    "stateDirectory",
    "outboxDirectory",
    "configFile",
    "tokenFile",
    "baseUrl",
    "runtime",
    "account",
    "schedule"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "packVersion": {
      "const": "1.0.0"
    },
    "name": {
      "type": "string",
      "maxLength": 300
    },
    "role": {
      "enum": [
        "windows-events",
        "server-logs",
        "native-monitor",
        "cloud-events",
        "protocol-gateway"
      ]
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "windows-task",
          "systemd",
          "container",
          "helm",
          "ansible"
        ]
      }
    },
    "sourceId": {
      "type": "string",
      "maxLength": 300
    },
    "appId": {
      "type": "string",
      "maxLength": 300
    },
    "installDirectory": {
      "type": "string",
      "maxLength": 300
    },
    "privateDirectory": {
      "type": "string",
      "maxLength": 300
    },
    "storageDirectory": {
      "type": "string",
      "maxLength": 300
    },
    "stateDirectory": {
      "type": "string",
      "maxLength": 300
    },
    "outboxDirectory": {
      "type": "string",
      "maxLength": 300
    },
    "configFile": {
      "type": "string",
      "maxLength": 300
    },
    "tokenFile": {
      "type": "string",
      "maxLength": 300
    },
    "baseUrl": {
      "type": "string",
      "maxLength": 300
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node"
      ],
      "properties": {
        "node": {
          "type": "string"
        },
        "python": {
          "type": "string"
        }
      }
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "uid": {
          "type": "integer",
          "minimum": 1000
        },
        "gid": {
          "type": "integer",
          "minimum": 1000
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intervalSeconds",
        "timeoutSeconds"
      ],
      "properties": {
        "intervalSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 3600
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "channels": {
          "type": "array",
          "items": {
            "enum": [
              "Security",
              "System",
              "Application",
              "ForwardedEvents",
              "Microsoft-Windows-Sysmon/Operational",
              "Microsoft-Windows-PowerShell/Operational",
              "Microsoft-Windows-Windows Defender/Operational"
            ]
          }
        },
        "computers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "maxEvents": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "file": {
          "type": "string"
        },
        "format": {
          "enum": [
            "plain",
            "docker-json",
            "journald-json"
          ]
        },
        "maxRecords": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "image": {
      "type": "string",
      "maxLength": 300
    },
    "kubernetes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "nodeName",
        "secretName"
      ],
      "properties": {
        "namespace": {
          "type": "string"
        },
        "nodeName": {
          "type": "string"
        },
        "secretName": {
          "type": "string"
        },
        "storageClaim": {
          "type": "string"
        }
      }
    }
  },
  "description": "The shipped validateManifest additionally enforces role/target compatibility, private origin, canonical paths, scoped storage, dedicated accounts and digest pinning. Run generate-deployment --check; JSON Schema alone is not installation approval."
}
