{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ingest-batch.v1.schema.json",
  "title": "SOC normalized ingest batch contract v1",
  "description": "An idempotent, bounded batch submitted by one source. Transport credentials are never part of this document.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "documentType", "sourceId", "receiptId", "sentAt", "records"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "documentType": { "const": "ingest-batch" },
    "sourceId": { "$ref": "normalized-record.v1.schema.json#/$defs/id" },
    "receiptId": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sentAt": { "type": "string", "format": "date-time" },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "normalized-record.v1.schema.json" }
    }
  }
}
