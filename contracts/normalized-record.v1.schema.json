{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "normalized-record.v1.schema.json",
  "title": "SOC normalized record contract v1",
  "description": "A bounded, source-bound record emitted by an installed connector after vendor data has been normalized server-side.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "documentType", "recordId", "sourceId", "estateId", "kind", "observedAt", "payload"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "documentType": { "const": "normalized-record" },
    "recordId": { "$ref": "#/$defs/id" },
    "sourceId": { "$ref": "#/$defs/id" },
    "estateId": { "$ref": "#/$defs/id" },
    "kind": { "$ref": "#/$defs/recordKind" },
    "observedAt": { "type": "string", "format": "date-time" },
    "payload": { "$ref": "#/$defs/payload" }
  },
  "allOf": [
    { "if": { "properties": { "kind": { "const": "alert.delivery" } } }, "then": { "properties": { "payload": { "required": ["title", "state", "findingRef"] } } } },
    { "if": { "properties": { "kind": { "const": "asset.snapshot" } } }, "then": { "properties": { "payload": { "required": ["title", "state", "assetRef"] } } } },
    { "if": { "properties": { "kind": { "const": "audit.event" } } }, "then": { "properties": { "payload": { "required": ["title", "state", "category"] } } } },
    { "if": { "properties": { "kind": { "const": "authentication.event" } } }, "then": { "properties": { "payload": { "required": ["title", "state", "identityRef"] } } } },
    { "if": { "properties": { "kind": { "const": "backup.status" } } }, "then": { "properties": { "payload": { "required": ["title", "state", "assetRef"] } } } },
    { "if": { "properties": { "kind": { "const": "case.record" } } }, "then": { "properties": { "payload": { "required": ["title", "state", "findingRef"] } } } },
    { "if": { "properties": { "kind": { "const": "compliance.record" } } }, "then": { "properties": { "payload": { "required": ["title", "state", "category"] } } } },
    { "if": { "properties": { "kind": { "const": "database.schema" } } }, "then": { "properties": { "payload": { "required": ["title", "state", "assetRef"] } } } },
    { "if": { "properties": { "kind": { "const": "endpoint.event" } } }, "then": { "properties": { "payload": { "required": ["title", "state", "assetRef"] } } } },
    { "if": { "properties": { "kind": { "const": "evidence.receipt" } } }, "then": { "properties": { "payload": { "required": ["title", "state", "category"] } } } },
    { "if": { "properties": { "kind": { "const": "file.integrity" } } }, "then": { "properties": { "payload": { "required": ["title", "state", "assetRef", "category"] } } } },
    { "if": { "properties": { "kind": { "const": "finding" } } }, "then": { "properties": { "payload": { "required": ["title", "state", "severity"] } } } },
    { "if": { "properties": { "kind": { "const": "governance.attestation" } } }, "then": { "properties": { "payload": { "required": ["title", "state", "category"] } } } },
    { "if": { "properties": { "kind": { "const": "governance.risk" } } }, "then": { "properties": { "payload": { "required": ["title", "state", "category"] } } } },
    { "if": { "properties": { "kind": { "const": "honeypot.event" } } }, "then": { "properties": { "payload": { "required": ["title", "state", "assetRef"] } } } },
    { "if": { "properties": { "kind": { "const": "identity.access" } } }, "then": { "properties": { "payload": { "required": ["title", "state", "identityRef"] } } } },
    { "if": { "properties": { "kind": { "const": "intel.indicator" } } }, "then": { "properties": { "payload": { "required": ["title", "state", "indicatorType", "indicator"] } } } },
    { "if": { "properties": { "kind": { "const": "intel.sync" } } }, "then": { "properties": { "payload": { "required": ["title", "state", "category"] } } } },
    { "if": { "properties": { "kind": { "const": "log.event" } } }, "then": { "properties": { "payload": { "required": ["title", "state", "message"] } } } },
    { "if": { "properties": { "kind": { "const": "network.event" } } }, "then": { "properties": { "payload": { "required": ["title", "state", "category"] } } } },
    { "if": { "properties": { "kind": { "const": "offboarding.record" } } }, "then": { "properties": { "payload": { "required": ["title", "state", "identityRef"] } } } },
    { "if": { "properties": { "kind": { "const": "phishing.report" } } }, "then": { "properties": { "payload": { "required": ["title", "state", "findingRef"] } } } },
    { "if": { "properties": { "kind": { "const": "remediation.record" } } }, "then": { "properties": { "payload": { "required": ["title", "state", "findingRef"] } } } },
    { "if": { "properties": { "kind": { "const": "retention.snapshot" } } }, "then": { "properties": { "payload": { "required": ["title", "state", "category"] } } } },
    { "if": { "properties": { "kind": { "const": "rule.definition" } } }, "then": { "properties": { "payload": { "required": ["title", "state", "ruleRef"] } } } },
    { "if": { "properties": { "kind": { "const": "scan.result" } } }, "then": { "properties": { "payload": { "required": ["title", "state", "assetRef"] } } } },
    { "if": { "properties": { "kind": { "const": "software.package" } } }, "then": { "properties": { "payload": { "required": ["title", "state", "assetRef"] } } } },
    { "if": { "properties": { "kind": { "const": "source.heartbeat" } } }, "then": { "properties": { "payload": { "required": ["title", "state", "category"] } } } },
    { "if": { "properties": { "kind": { "const": "vulnerability.finding" } } }, "then": { "properties": { "payload": { "required": ["title", "state", "assetRef", "severity"] } } } }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "shortText": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": ".*\\S.*" },
    "longText": { "type": "string", "minLength": 1, "maxLength": 4000, "pattern": ".*\\S.*" },
    "severity": { "enum": ["critical", "high", "medium", "low", "info", "unknown"] },
    "state": { "enum": ["open", "closed", "active", "inactive", "ok", "warn", "failed", "unknown"] },
    "recordKind": {
      "enum": [
        "alert.delivery",
        "asset.snapshot",
        "audit.event",
        "authentication.event",
        "backup.status",
        "case.record",
        "compliance.record",
        "database.schema",
        "endpoint.event",
        "evidence.receipt",
        "file.integrity",
        "finding",
        "governance.attestation",
        "governance.risk",
        "honeypot.event",
        "identity.access",
        "intel.indicator",
        "intel.sync",
        "log.event",
        "network.event",
        "offboarding.record",
        "phishing.report",
        "remediation.record",
        "retention.snapshot",
        "rule.definition",
        "scan.result",
        "software.package",
        "source.heartbeat",
        "vulnerability.finding"
      ]
    },
    "scalar": {
      "oneOf": [
        { "type": "string", "maxLength": 1000 },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" }
      ]
    },
    "fields": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,63}$" },
      "additionalProperties": { "$ref": "#/$defs/scalar" }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "state"],
      "properties": {
        "title": { "$ref": "#/$defs/shortText" },
        "state": { "$ref": "#/$defs/state" },
        "severity": { "$ref": "#/$defs/severity" },
        "assetRef": { "$ref": "#/$defs/id" },
        "identityRef": { "$ref": "#/$defs/id" },
        "ruleRef": { "$ref": "#/$defs/id" },
        "findingRef": { "$ref": "#/$defs/id" },
        "indicatorType": { "enum": ["ip", "domain", "url", "hash", "email", "other"] },
        "indicator": { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": ".*\\S.*" },
        "message": { "$ref": "#/$defs/longText" },
        "summary": { "$ref": "#/$defs/longText" },
        "channel": { "$ref": "#/$defs/id" },
        "category": { "$ref": "#/$defs/id" },
        "count": { "type": "integer", "minimum": 0 },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "dueAt": { "type": "string", "format": "date-time" },
        "fields": { "$ref": "#/$defs/fields" }
      }
    }
  }
}
